# AI Provider Configuration
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai-compatible

# Heavy Task Model (Exact Source Extraction & Difficult Reasoning)
# Uses a separate API key/endpoint for compute-intensive operations
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_REASONING_MODEL=gpt-4o
AI_MODEL_EXACT_EXTRACTION=gpt-4o

# Neon PostgreSQL Database (Server-only connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Storage (Optional local override — in Cloudflare Workers, QUIZY_BUCKET binding is used)
R2_BUCKET_NAME=quizy-storage

